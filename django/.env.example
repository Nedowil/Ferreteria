# Copiar a .env y ajustar
SECRET_KEY=cambia-esta-llave-en-produccion
DEBUG=True
ALLOWED_HOSTS=*
TIME_ZONE=America/Guatemala

# Base de datos: postgresql (default) o sqlite
DB_ENGINE=postgresql
DB_NAME=ferreteria
DB_USER=ferreteria
DB_PASSWORD=secret
DB_HOST=127.0.0.1
DB_PORT=5432

# IVA por defecto (Guatemala 12%)
COMPANY_DEFAULT_TAX_RATE=12
# Los precios de venta YA incluyen IVA (precio al público). False = IVA aparte.
COMPANY_PRICES_INCLUDE_TAX=True
