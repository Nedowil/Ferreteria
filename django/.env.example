# Copiar a .env y ajustar
SECRET_KEY=cambia-esta-llave-en-produccion
DEBUG=True
ALLOWED_HOSTS=*
TIME_ZONE=America/Guatemala
# En producción: dominio(s) público(s), separados por coma
# CSRF_TRUSTED_ORIGINS=https://ferreteria.example.com

# Base de datos: postgresql (default) o sqlite
DB_ENGINE=postgresql
DB_NAME=ferreteria
DB_USER=ferreteria
DB_PASSWORD=secret
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Despliegue (producción) ---
# Admin inicial que crea `init_app` / entrypoint del contenedor
DJANGO_SUPERUSER_EMAIL=admin@ferreteria.gt
DJANGO_SUPERUSER_PASSWORD=cambia-esta-contrasena
# gunicorn / contenedor
WEB_CONCURRENCY=3
WEB_PORT=8000
# Endurecer TLS cuando haya un proxy con HTTPS delante
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
# Sembrar datos de demostración en el primer arranque (solo demos)
SEED_DEMO=false

# IVA por defecto (Guatemala 12%)
COMPANY_DEFAULT_TAX_RATE=12
# Los precios de venta YA incluyen IVA (precio al público). False = IVA aparte.
COMPANY_PRICES_INCLUDE_TAX=True

# --- Facturación Electrónica (FEL) ---
# Driver: 'stub' (simulado, por defecto) o 'infile' (certificador real).
FEL_DRIVER=stub
FEL_ENVIRONMENT=PRUEBAS
FEL_CERTIFICADOR=Infile

# Credenciales Infile/FEEL (rellenar cuando llegue el sandbox).
FEL_INFILE_USUARIO=
FEL_INFILE_LLAVE_WS=
FEL_INFILE_LLAVE_FIRMA=
FEL_INFILE_ALIAS=
FEL_INFILE_NIT_EMISOR=
FEL_INFILE_CORREO_COPIA=
FEL_INFILE_IDENTIFICADOR_PREFIX=FERRE
# URLs (por defecto apuntan a producción Infile; el sandbox usa otras)
# FEL_INFILE_FIRMA_URL=
# FEL_INFILE_CERT_URL=
# FEL_INFILE_ANUL_URL=
